<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <div class="navbar">
            <h1>InfoCircle</h1>
            <a href="/posts/new" class="btn btn-primary">+ New Post</a>
        </div>

        <% if (posts.length === 0) { %>
            <p class="empty">No posts yet. Be the first to write one!</p>
        <% } %>

        <% for(post of posts) { %>
            <div class="post">
                <h3 class="username">@<%= post.username %></h3>
                <p class="content"><%= post.content %></p>
                <div class="post-actions">
                    <a href="/posts/<%= post.id %>" class="btn btn-secondary">View</a>
                    <a href="/posts/<%= post.id %>/edit" class="btn btn-secondary">Edit</a>
                    <form method="post" action="/posts/<%= post.id %>?_method=DELETE">
                        <button class="btn btn-danger">Delete</button>
                    </form>
                </div>
            </div>
        <% } %>

        <footer>&copy Owned and built by Aditya Pratap Singh</footer>
    </div>
</body>
</html>
